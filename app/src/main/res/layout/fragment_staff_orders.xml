<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F1EB"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BREWLOOP  /  STAFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.13"
        android:textColor="#956240" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Live Order Queue"
        android:textStyle="bold"
        android:textSize="29sp"
        android:textColor="#302016" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="WEEK 1 DEMO · Sample orders only"
        android:textSize="12sp"
        android:textColor="#866F61" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:padding="14dp"
            android:orientation="vertical"
            android:background="@drawable/staff_summary_card">

            <TextView
                android:id="@+id/textStaffActiveCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textStyle="bold"
                android:textColor="#332117"
                android:textSize="24sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active orders"
                android:textColor="#715B4A"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/staff_summary_card">

            <TextView
                android:id="@+id/textStaffReadyCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="#332117" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready for pickup"
                android:textColor="#715B4A"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:text="Orders"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#302016" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerStaffOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="vertical" />
</LinearLayout>
