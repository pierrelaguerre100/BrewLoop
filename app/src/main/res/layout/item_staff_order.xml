<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#EADBD0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textStaffOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Order ord102"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#352219" />

            <TextView
                android:id="@+id/textStaffStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/staff_status_pill"
                android:text="Received"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textStaffCustomerId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Customer: u001"
            android:textColor="#8C776C"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#EFE7DF" />

        <TextView
            android:id="@+id/textStaffItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1× Blueberry Muffin"
            android:lineSpacingExtra="4dp"
            android:textSize="14sp"
            android:textColor="#453329" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textStaffPickup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pickup 09:20"
                android:textColor="#756052"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textStaffTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$3.00"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#352219" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonStaffNextStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#684A38"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:text="Mark Preparing" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
